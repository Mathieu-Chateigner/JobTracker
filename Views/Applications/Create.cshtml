@model JobTracker.Models.JobApplication
@{
    ViewData["Title"] = "Nouvelle candidature";
}

<div class="page-container page-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">Nouvelle candidature</h1>
            <p class="page-subtitle">Collez une URL pour remplir automatiquement, ou saisissez manuellement</p>
        </div>
        <a href="/Applications" class="btn btn-ghost">← Retour</a>
    </div>

    @* ── Panneau import URL ── *@
    <div class="panel url-import-panel" id="importPanel">
        <p class="import-label">Importer depuis une URL</p>
        <div class="url-import-row">
            <input type="url" id="jobUrlInput" class="form-input"
                   placeholder="https://fr.indeed.com/viewjob?jk=..." />
            <button type="button" class="btn btn-primary" id="fetchBtn" onclick="fetchJobInfo()">
                <span id="fetchBtnText">Remplir auto ↓</span>
            </button>
        </div>
        <div id="importStatus" class="import-status" style="display:none"></div>
    </div>

    @* ── Formulaire principal ── *@
    <div class="panel" id="formPanel">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            @await Html.PartialAsync("_Form", Model)
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="/Applications" class="btn btn-ghost">Annuler</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
async function fetchJobInfo() {
    const url = document.getElementById('jobUrlInput').value.trim();
    if (!url) return;

    const btn = document.getElementById('fetchBtn');
    const btnText = document.getElementById('fetchBtnText');

    btn.disabled = true;
    btnText.textContent = 'Ouverture…';
    showImportStatus('loading');

    try {
        const resp = await fetch(`/Applications/FetchJobInfo?url=${encodeURIComponent(url)}`, {
            signal: AbortSignal.timeout(30000)
        });
        const data = await resp.json();

        if (!resp.ok || !data.success) {
            showImportStatus(data.error || 'error');
            return;
        }

        let filled = 0;
        if (data.jobTitle)    { setField('JobTitle',    data.jobTitle);    filled++; }
        if (data.companyName) { setField('CompanyName', data.companyName); filled++; }
        if (data.location)    { setField('Location',    data.location);    filled++; }
        setField('JobUrl', url);

        if (filled > 0) {
            showImportStatus('success', filled);
            document.getElementById('formPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
        } else {
            showImportStatus('no_data');
        }

    } catch (e) {
        showImportStatus(e.name === 'TimeoutError' ? 'timeout' : 'network_error');
    } finally {
        btn.disabled = false;
        btnText.textContent = 'Remplir auto ↓';
    }
}

function setField(name, value) {
    const el = document.getElementById(name) || document.querySelector(`[name="${name}"]`);
    if (el && value) el.value = value;
}

function showImportStatus(type, filledCount) {
    const status = document.getElementById('importStatus');
    status.style.display = 'flex';
    status.className = 'import-status';

    const messages = {
        loading:       ['import-loading', '⏳ Ouverture de la page dans un navigateur headless…'],
        success:       ['import-success', `✓ ${filledCount} champ${filledCount > 1 ? 's remplis' : ' rempli'}. Vérifiez et complétez si nécessaire.`],
        no_data:       ['import-warn',    "⚠ Page chargée mais aucune donnée extraite. L'URL a été sauvegardée — remplissez manuellement."],
        timeout:       ['import-warn',    '⚠ La page a mis trop de temps à répondre. Réessayez ou remplissez manuellement.'],
        invalid_url:   ['import-error',   '✕ URL invalide. Assurez-vous qu\'elle commence par https://'],
        network_error: ['import-warn',    '⚠ Impossible d\'accéder à la page. Vérifiez votre connexion ou remplissez manuellement.'],
        unexpected:    ['import-warn',    '⚠ Une erreur est survenue. Vous pouvez remplir le formulaire manuellement.'],
    };

    const [cls, msg] = messages[type] ?? messages.unexpected;
    status.classList.add(cls);
    status.innerHTML = msg;
}

document.getElementById('jobUrlInput').addEventListener('keydown', e => {
    if (e.key === 'Enter') { e.preventDefault(); fetchJobInfo(); }
});
</script>
}
