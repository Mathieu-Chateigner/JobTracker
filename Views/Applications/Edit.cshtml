@model JobTracker.Models.JobApplication
@using System.Globalization
@{
    ViewData["Title"] = "Modifier — " + Model.CompanyName;
    var fr = new CultureInfo("fr-FR");
}

<div class="page-container page-narrow">
    <div class="page-header">
        <div>
            <h1 class="page-title">@Model.CompanyName</h1>
            <p class="page-subtitle">@Model.JobTitle · Candidature du @Model.AppliedDate.ToString("d MMMM yyyy", fr)</p>
        </div>
        <a href="/Applications" class="btn btn-ghost">← Retour</a>
    </div>

    <div class="panel">
        @* Formulaire de modification *@
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            @await Html.PartialAsync("_Form", Model)
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="/Applications" class="btn btn-ghost">Annuler</a>
            </div>
        </form>

        @* Suppression — formulaire séparé (les forms imbriqués sont invalides en HTML) *@
        <div style="padding-top:1rem; border-top:1px solid var(--border); margin-top:1rem;">
            <form method="post" action="/Applications/Delete/@Model.Id"
                  onsubmit="return confirm('Supprimer cette candidature ?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Supprimer la candidature</button>
            </form>
        </div>
    </div>
</div>
