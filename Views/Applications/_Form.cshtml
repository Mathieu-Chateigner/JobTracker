@model JobTracker.Models.JobApplication
@using JobTracker.Models

<div class="form-grid">
    <div class="form-group form-col-2">
        <label asp-for="CompanyName" class="form-label">Entreprise *</label>
        <input asp-for="CompanyName" class="form-input" placeholder="ex. Acme Corp" />
        <span asp-validation-for="CompanyName" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="JobTitle" class="form-label">Poste *</label>
        <input asp-for="JobTitle" class="form-input" placeholder="ex. Développeur Senior" />
        <span asp-validation-for="JobTitle" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="Location" class="form-label">Lieu</label>
        <div class="location-wrap">
            <input asp-for="Location" id="locationInput" class="form-input"
                   placeholder="ex. Paris, Île-de-France"
                   autocomplete="off" />
            <span class="location-pin">📍</span>
        </div>
        <span asp-validation-for="Location" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="AppliedDate" class="form-label">Date de candidature *</label>
        <input asp-for="AppliedDate" type="date" class="form-input" />
        <span asp-validation-for="AppliedDate" class="form-error"></span>
    </div>

    <div class="form-group form-col-full">
        <label asp-for="JobUrl" class="form-label">URL de l'offre</label>
        <input asp-for="JobUrl" class="form-input" placeholder="https://..." />
        <span asp-validation-for="JobUrl" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="Status" class="form-label">Statut</label>
        <select asp-for="Status" id="statusSelect" class="form-select">
            @foreach (var s in Enum.GetValues<JobTracker.Models.ApplicationStatus>())
            {
                if (Model.Status == s)
                {
                    <option value="@((int)s)" selected>@s.ToFrench()</option>
                }
                else
                {
                    <option value="@((int)s)">@s.ToFrench()</option>
                }
            }
        </select>
    </div>

    <div class="form-group form-col-2" id="interviewDateGroup">
        <label asp-for="InterviewDate" class="form-label">Date d'entretien / deadline</label>
        <input type="datetime-local" id="InterviewDate" name="InterviewDate"
               class="form-input"
               value="@(Model.InterviewDate?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
    </div>

    <div class="form-group form-col-2">
        <label asp-for="LastResponseDate" class="form-label">Date de dernière réponse</label>
        <input asp-for="LastResponseDate" type="date" class="form-input" />
    </div>

    <div class="form-group form-col-2">
        <label asp-for="SalaryExpectation" class="form-label">Salaire souhaité (€)</label>
        <input asp-for="SalaryExpectation" type="number" step="1" class="form-input" placeholder="ex. 45000" />
        <span asp-validation-for="SalaryExpectation" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label class="form-label">Note recruteur / entreprise</label>
        <div class="star-picker">
            <input type="hidden" name="Rating" id="ratingInput" value="@(Model.Rating?.ToString() ?? "")" />
            <button type="button" class="star-btn" aria-label="1 étoile">★</button>
            <button type="button" class="star-btn" aria-label="2 étoiles">★</button>
            <button type="button" class="star-btn" aria-label="3 étoiles">★</button>
            <button type="button" class="star-btn" aria-label="4 étoiles">★</button>
            <button type="button" class="star-btn" aria-label="5 étoiles">★</button>
        </div>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="RefusalMailUrl" class="form-label">URL du mail de refus</label>
        <input asp-for="RefusalMailUrl" class="form-input" placeholder="https://mail.google.com/..." />
        <span asp-validation-for="RefusalMailUrl" class="form-error"></span>
    </div>

    <div class="form-group form-col-2">
        <label asp-for="TeamsUrl" class="form-label">Lien Teams</label>
        <input asp-for="TeamsUrl" class="form-input" placeholder="https://teams.microsoft.com/l/meetup-join/..." />
        <span asp-validation-for="TeamsUrl" class="form-error"></span>
    </div>

    <div class="form-group form-col-full">
        <label asp-for="Notes" class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-input form-textarea" placeholder="Nom du recruteur, impressions, prochaines étapes…" rows="4"></textarea>
        <span asp-validation-for="Notes" class="form-error"></span>
    </div>
</div>

<script>
(function () {
    const INTERVIEW_STATUSES = new Set([2, 4, 6, 8]); // EntretienRecruteur, EntretienTech, TestTechnique, EntretienRH
    const select = document.getElementById('statusSelect');
    const group  = document.getElementById('interviewDateGroup');
    if (!select || !group) return;
    function toggle() {
        group.style.display = INTERVIEW_STATUSES.has(parseInt(select.value)) ? '' : 'none';
    }
    select.addEventListener('change', toggle);
    toggle();
})();

(function () {
    const input = document.getElementById('ratingInput');
    const btns  = Array.from(document.querySelectorAll('.star-btn'));
    if (!input || btns.length === 0) return;

    function highlight(n) {
        btns.forEach((b, i) => b.classList.toggle('lit', i < n));
    }

    highlight(parseInt(input.value) || 0);

    btns.forEach((btn, idx) => {
        btn.addEventListener('mouseenter', () => highlight(idx + 1));
        btn.addEventListener('mouseleave', () => highlight(parseInt(input.value) || 0));
        btn.addEventListener('click', () => {
            const cur = parseInt(input.value) || 0;
            const next = cur === idx + 1 ? 0 : idx + 1; // click same star to clear
            input.value = next || '';
            highlight(next);
        });
    });
})();
</script>
