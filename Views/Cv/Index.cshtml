@{
    ViewData["Title"] = "Mon CV";
    bool hasCv = ViewBag.HasCv == true;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Mon CV</h1>
        <p class="page-subtitle">Visualisez et mettez à jour votre CV</p>
    </div>
    <form asp-action="Upload" asp-controller="Cv" method="post" enctype="multipart/form-data" class="cv-upload-form">
        @Html.AntiForgeryToken()
        <label class="btn-upload" title="Importer un nouveau CV (PDF)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            @(hasCv ? "Remplacer le CV" : "Importer un CV")
            <input type="file" name="file" accept=".pdf" style="display:none" onchange="this.form.submit()" />
        </label>
    </form>
</div>

@if (TempData["Error"] != null)
{
    <div class="toast toast-error" style="position:static;margin-bottom:1.5rem;">
        ✕ @TempData["Error"]
    </div>
}

@if (hasCv)
{
    <div class="cv-viewer-wrap">
        <embed src="/cv/cv.pdf" type="application/pdf" class="cv-embed" />
    </div>
}
else
{
    <div class="cv-empty">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
        </svg>
        <p>Aucun CV importé pour l'instant.</p>
        <p class="text-muted">Cliquez sur « Importer un CV » pour ajouter votre PDF.</p>
    </div>
}
