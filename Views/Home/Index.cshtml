@model JobTracker.Controllers.DashboardStats
@using JobTracker.Models
@{
    ViewData["Title"] = "Tableau de bord";
}

<div class="dashboard">
    <div class="page-header">
        <h1 class="page-title">Tableau de bord</h1>
        <p class="page-subtitle">Votre recherche d'emploi en un coup d'œil</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card stat-total">
            <div class="stat-value">@Model.Total</div>
            <div class="stat-label">Total</div>
        </div>
        <div class="stat-card stat-progress">
            <div class="stat-value">@Model.InProgress</div>
            <div class="stat-label">En cours</div>
        </div>
        <div class="stat-card stat-offer">
            <div class="stat-value">@Model.Offers</div>
            <div class="stat-label">Offres</div>
        </div>
        <div class="stat-card stat-rejected">
            <div class="stat-value">@Model.Refused</div>
            <div class="stat-label">Refusés</div>
        </div>
        <div class="stat-card stat-silent">
            <div class="stat-value">@Model.NoResponse</div>
            <div class="stat-label">Sans réponse</div>
        </div>
    </div>

    <div class="dashboard-bottom">
        <div class="panel">
            <h2 class="panel-title">Répartition par statut</h2>
            @if (Model.Total == 0)
            {
                <p class="empty-msg">Aucune candidature pour le moment.</p>
            }
            else
            {
                <div class="breakdown-list">
                    @foreach (var entry in Model.StatusBreakdown.OrderByDescending(e => e.Value))
                    {
                        var pct = Model.Total > 0 ? (int)Math.Round(entry.Value * 100.0 / Model.Total) : 0;
                        <div class="breakdown-row">
                            <div class="breakdown-info">
                                <span class="status-dot status-@(entry.Key.ToString().ToLower())"></span>
                                <span class="breakdown-name">@entry.Key.ToFrench()</span>
                                <span class="breakdown-count">@entry.Value</span>
                            </div>
                            <div class="breakdown-bar-wrap">
                                <div class="breakdown-bar status-bar-@(entry.Key.ToString().ToLower())" style="width:@(pct)%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="panel">
            <h2 class="panel-title">Candidatures récentes</h2>
            @if (!Model.RecentApplications.Any())
            {
                <p class="empty-msg">Aucune candidature. <a href="/Applications/Create">Ajoutez la première →</a></p>
            }
            else
            {
                <div class="recent-list">
                    @foreach (var app in Model.RecentApplications)
                    {
                        <a href="/Applications/Edit/@app.Id" class="recent-item">
                            <div class="recent-info">
                                <span class="recent-company">@app.CompanyName</span>
                                <span class="recent-role">@app.JobTitle</span>
                            </div>
                            <div class="recent-meta">
                                <span class="status-badge status-@(app.Status.ToString().ToLower())">@app.Status.ToFrench()</span>
                                <span class="recent-date">@app.AppliedDate.ToString("d MMM", new System.Globalization.CultureInfo("fr-FR"))</span>
                            </div>
                        </a>
                    }
                </div>
                <a href="/Applications" class="panel-link">Voir toutes les candidatures →</a>
            }
        </div>
    </div>
</div>
